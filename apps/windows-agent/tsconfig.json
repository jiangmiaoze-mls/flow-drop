{
  "compilerOptions": {
    /* 基础编译目标 */
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],

    /* 输出目录 */
    "outDir": "./dist",
    "rootDir": "./src",

    /* 源码映射（调试用） */
    "sourceMap": true,
    "removeComments": true,

    /* 类型检查严格模式 */
    "strict": true,
//    "noUnusedLocals": true,
//    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,

    /* 模块解析 */
    "baseUrl": ".",
    "paths": {
      "@flowdrop/config": ["../../packages/config"],
      "@flowdrop/types": ["../../packages/types"]
    },
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,

    /* 其他 */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
